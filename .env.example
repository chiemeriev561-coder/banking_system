# Database Configuration
DATABASE_URL=postgresql+psycopg://victor:2323@localhost:5432/banking_db

# JWT Configuration
JWT_SECRET_KEY=your-32-byte-secret-key-here-minimum-length

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://yourdomain.com

# Rate Limiting (requests per time period)
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_BANKING=100/minute
RATE_LIMIT_ADMIN=50/minute
RATE_LIMIT_DEFAULT=60/minute

# Security
FORCE_HTTPS=false

# Environment
ENVIRONMENT=development
